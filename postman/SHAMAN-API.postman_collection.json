{
  "info": {
    "name": "SHAMAN API",
    "_postman_id": "5a1e0c1e-shaman-progra3",
    "description": "API REST de SHAMANapp (Progra III). Una request por endpoint.\n\nUso: hacé **Login** primero; el token se guarda solo y lo usan todas las requests protegidas. Para actuar con otro rol (Lugar, admin), volvé a hacer Login con ese usuario.\n\nLos valores entre `< >` hay que reemplazarlos por un id real.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:4000/toyvivo",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "4000",
          "path": [
            "toyvivo"
          ]
        },
        "description": "Verifica que el servidor está levantado.",
        "auth": {
          "type": "noauth"
        }
      }

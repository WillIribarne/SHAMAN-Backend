    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "registro"
              ]
            },
            "description": "Registro público. `tipo` puede ser `jugador` o `lugar` (un admin no puede autoregistrarse).\n\nEjemplo de body para un Lugar:\n```json\n{\n  \"tipo\": \"lugar\",\n  \"username\": \"laredonda\",\n  \"password\": \"password123\",\n  \"nombre\": \"Complejo La Redonda\",\n  \"mail\": \"laredonda@test.com\",\n  \"telefono\": \"1144445555\",\n  \"disponibilidad\": [\n    {\n      \"dia\": \"sabado\",\n      \"hora\": \"18:00\",\n      \"tipo_cancha\": 5\n    }\n  ]\n}\n```",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"jugador\",\n  \"username\": \"lionel\",\n  \"password\": \"password123\",\n  \"nombre\": \"Lionel\",\n  \"apellido\": \"Messi\",\n  \"mail\": \"lionel@test.com\",\n  \"telefono\": \"1122334455\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            },
            "description": "Se puede entrar con `mail` o con `username` (mandando uno de los dos junto con `password`). Devuelve `{ token, usuario }`. El token y el id del usuario logueado se guardan solos en las variables `token` e `idUsuario`; todas las requests protegidas usan ese token. Para actuar como otro usuario (un Lugar, el admin), hacé login con ese usuario.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": \"lionel@test.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token y el id del usuario logueado",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "  pm.collectionVariables.set('idUsuario', pm.response.json().usuario._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener todos los usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Solo admin. Lista los usuarios activos.",
            "auth": {
              "type": "inherit"
            }
          }
        },
        {
          "name": "Obtener usuario por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{idUsuario}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{idUsuario}}"
              ]
            },
            "description": "Cualquier usuario logueado. El `historial` solo aparece si es tu propio perfil (o sos admin).",
            "auth": {
              "type": "inherit"
            }
          }
        },
        {
          "name": "Modificar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{idUsuario}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{idUsuario}}"
              ]
            },
            "description": "Solo el propio usuario o un admin. No se puede cambiar `tipo`, `estado`, `estadisticas`, `historial` ni `equipos_conformados`.",
            "auth": {
              "type": "inherit"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"1199998888\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "<id del usuario>",
                  "description": "Id del usuario a eliminar"
                }
              ]
            },
            "description": "Solo admin. Baja lógica (estado → eliminado).",
            "auth": {
              "type": "inherit"
            }
          }
        }
      ]
    },

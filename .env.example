# Copiar este archivo como .env (ya está en .gitignore) y completar los valores reales.
# El parcial pide documentar las variables de entorno en el README -- este archivo cumple
# esa función y además queda commiteado (a diferencia de .env).

# Cadena de conexión a MongoDB Atlas.
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<nombreDB>?retryWrites=true&w=majority
MONGO_URI=

# Puerto donde levanta el servidor Express.
PORT=4000

# Entorno de ejecución: development | production
NODE_ENV=development
